<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Connection Settings">
        <EditTextPreference
            android:defaultValue=""
            android:inputType="textUri"
            android:key="webview_url"
            android:title="ImmichFrame Server URL" />
        <EditTextPreference
            android:defaultValue=""
            android:key="authSecret"
            android:title="Authorization Secret" />
        <EditTextPreference
            android:defaultValue=""
            android:key="frameName"
            android:summary="Advertised on the local network so the frame can be found by name"
            android:title="Frame Name" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Display Options">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="useWebView"
            android:title="Use WebView?" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="blurredBackground"
            android:title="Blurred Background?" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="showCurrentDate"
            android:title="Show Current Date?" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Tamper Protection">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="settingsPincode"
            android:title="Protect access to these settings with pincode?" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="settingsLock"
            android:title="Fully disable/lock access to these settings?" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Image Adjustments">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="imageAdjustments"
            android:title="Image Adjustments?" />
        <com.immichframe.immichframe.SeekBarPreference
            android:key="image_brightness"
            android:title="Brightness"
            android:defaultValue="0"
            app:min="-50"
            app:max="50" />
        <com.immichframe.immichframe.SeekBarPreference
            android:key="image_contrast"
            android:title="Contrast"
            android:defaultValue="0"
            app:min="-50"
            app:max="50" />
        <com.immichframe.immichframe.SeekBarPreference
            android:key="image_red_channel"
            android:title="Red Channel"
            android:defaultValue="0"
            app:min="-50"
            app:max="50" />
        <com.immichframe.immichframe.SeekBarPreference
            android:key="image_green_channel"
            android:title="Green Channel"
            android:defaultValue="0"
            app:min="-50"
            app:max="50" />
        <com.immichframe.immichframe.SeekBarPreference
            android:key="image_blue_channel"
            android:title="Blue Channel"
            android:defaultValue="0"
            app:min="-50"
            app:max="50" />
        <com.immichframe.immichframe.SeekBarPreference
            android:key="image_gamma"
            android:title="Gamma (approx)"
            android:summary="More accurate for widgets"
            android:defaultValue="100"
            app:min="10"
            app:max="200" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Active Times">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="activeTimes"
            android:title="Set Active Hours?" />
        <Preference
            android:dependency="activeTimes"
            android:key="active_schedule_edit"
            android:summary="Per-weekday on/off times"
            android:title="Edit Active Schedule" />
        <Preference
            android:dependency="activeTimes"
            android:key="active_schedule_admin"
            android:summary="Allow the frame to turn off the screen and sleep the device during inactive hours"
            android:title="Enable Screen-Off Permission" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Android Settings">
        <Preference
            android:defaultValue=""
            android:key="androidSettings"
            android:title="Launch Android Settings" />
        <Preference
            android:key="openOtherLauncher"
            android:summary="Switch to another home screen without changing the default"
            android:title="Open Another Launcher" />
        <Preference
            android:key="changeDefaultLauncher"
            android:summary="Choose again which home screen starts when the device boots"
            android:title="Change Default Launcher" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Interactions">
        <Preference
            android:key="interactions"
            android:selectable="false"
            android:summary="⬆️ Open Settings\n🆗 Play/Pause\n⬅️ Previous Image\n➡️ Next Image\n👇 Open Settings (swipe)" />
    </PreferenceCategory>

    <Preference
        android:key="closeSettings"
        android:layout="@layout/pref_close_button" />
</PreferenceScreen>